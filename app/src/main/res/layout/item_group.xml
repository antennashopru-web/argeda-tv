<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
    android:layout_marginBottom="2dp" android:background="@drawable/item_bg" android:focusable="true" android:clickable="true"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:singleLine="true" android:ellipsize="end" android:textColor="@color/text" android:textSize="15sp" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textColor="@color/muted" android:textSize="13sp" />
</LinearLayout>
