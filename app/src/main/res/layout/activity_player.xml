<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView android:id="@+id/video" android:layout_width="match_parent"
        android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit"
        app:shutter_background_color="@android:color/black" android:focusable="false" />

    <ProgressBar android:id="@+id/buffering" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="center" android:indeterminateTint="@color/accent" android:visibility="gone" />

    <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/panel_bg" android:gravity="center"
        android:padding="18dp" android:textColor="@color/text" android:textSize="16sp" android:visibility="gone" />

    <TextView android:id="@+id/digits" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="24dp" android:background="@drawable/panel_bg"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:textColor="@color/text" android:textSize="34sp" android:textStyle="bold" android:visibility="gone" />

    <TextView android:id="@+id/seek" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="28dp" android:background="@drawable/panel_bg"
        android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" android:visibility="gone" />

    <!-- Телепрограмма канала справа (кнопка «Телепрограмма») -->
    <LinearLayout android:id="@+id/epgSide" android:layout_width="440dp" android:layout_height="match_parent"
        android:layout_gravity="end" android:background="@drawable/side_bg" android:orientation="vertical"
        android:paddingTop="12dp" android:visibility="gone">
        <TextView android:id="@+id/epgTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp"
            android:singleLine="true" android:ellipsize="end" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:id="@+id/epgSideEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/epgSideList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Боковой список каналов (влево на пульте, «Список» на телефоне) -->
    <LinearLayout android:id="@+id/side" android:layout_width="380dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="@drawable/side_bg" android:orientation="vertical"
        android:paddingTop="12dp" android:visibility="gone">
        <!-- Категория (касание — выбор из списка) и поиск по всем каналам. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/sideTitle" android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:background="@drawable/btn_bg" android:focusable="true"
                android:clickable="true" android:gravity="center_vertical" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/text" android:textSize="14sp" />
            <ImageView android:id="@+id/sideSearchBtn" android:layout_width="44dp" android:layout_height="40dp"
                android:layout_marginStart="8dp" android:background="@drawable/btn_bg" android:focusable="true"
                android:clickable="true" android:padding="9dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_search" android:contentDescription="Поиск канала" />
        </LinearLayout>
        <EditText android:id="@+id/sideSearch" android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp"
            android:background="@drawable/field_bg" android:hint="Поиск канала"
            android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen" android:inputType="text" android:singleLine="true"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/sideList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Сведения о канале снизу -->
    <LinearLayout android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="20dp" android:background="@drawable/panel_bg"
        android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/infoArch" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" android:background="@drawable/live_bg" android:paddingStart="8dp"
                android:paddingEnd="8dp" android:text="ЗАПИСЬ" android:textColor="@color/text" android:textSize="12sp"
                android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/infoNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="12dp" android:textColor="@color/accentLight" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/infoName" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/infoClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:textColor="@color/muted" android:textSize="16sp" />
        </LinearLayout>
        <TextView android:id="@+id/infoGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:id="@+id/infoNow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/text" android:textSize="16sp" android:visibility="gone" />
        <ProgressBar android:id="@+id/infoProg" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
            android:max="1000" android:progressTint="@color/accent" android:visibility="gone" />
        <TextView android:id="@+id/infoNext" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <!-- Кнопки переносятся на новую строку, если не помещаются (телефон в книжной ориентации). -->
            <ru.argeda.tv.FlowRow android:id="@+id/infoBtns" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView android:id="@+id/bLive" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginEnd="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_live" android:drawablePadding="8dp"
                    android:text="В прямой эфир" android:textColor="@color/text" android:visibility="gone" />
                <TextView android:id="@+id/bList" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@drawable/btn_bg" android:focusable="true" android:clickable="true" android:gravity="center"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:drawableStart="@drawable/ic_list" android:drawablePadding="8dp"
                    android:text="Каналы" android:textColor="@color/text" />
                <TextView android:id="@+id/bEpg" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_epg" android:drawablePadding="8dp"
                    android:text="Телепрограмма" android:textColor="@color/text" />
                <TextView android:id="@+id/bFav" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_star_outline" android:drawablePadding="8dp"
                    android:text="В избранное" android:textColor="@color/text" />
                <TextView android:id="@+id/bFit" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_fit" android:drawablePadding="8dp"
                    android:text="Формат" android:textColor="@color/text" />
                <TextView android:id="@+id/bRot" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_rotate" android:drawablePadding="8dp"
                    android:textColor="@color/text" android:visibility="gone" />
                <TextView android:id="@+id/bSleep" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_sleep" android:drawablePadding="8dp"
                    android:text="Сон" android:textColor="@color/text" />
                <TextView android:id="@+id/bAudio" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_audio" android:drawablePadding="8dp"
                    android:text="Звук" android:textColor="@color/text" android:visibility="gone" />
                <TextView android:id="@+id/bQuality" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_hd" android:drawablePadding="8dp"
                    android:text="Качество" android:textColor="@color/text" android:visibility="gone" />
                <TextView android:id="@+id/bSubs" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_cc" android:drawablePadding="8dp"
                    android:text="Субтитры" android:textColor="@color/text" android:visibility="gone" />
                <TextView android:id="@+id/bStats" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                    android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:drawableStart="@drawable/ic_info" android:drawablePadding="8dp"
                    android:text="Сведения" android:textColor="@color/text" />
            </ru.argeda.tv.FlowRow>
    </LinearLayout>
</FrameLayout>
