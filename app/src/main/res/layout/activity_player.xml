<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black" android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView android:id="@+id/video" android:layout_width="match_parent"
        android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit"
        app:shutter_background_color="@android:color/black" android:focusable="false" />

    <ProgressBar android:id="@+id/buffering" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="center" android:indeterminateTint="@color/accent" android:visibility="gone" />

    <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/panel_bg" android:gravity="center"
        android:padding="18dp" android:textColor="@color/text" android:textSize="16sp" android:visibility="gone" />

    <TextView android:id="@+id/digits" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="24dp" android:background="@drawable/panel_bg"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:textColor="@color/text" android:textSize="34sp" android:textStyle="bold" android:visibility="gone" />

    <!-- Боковой список каналов (влево на пульте, «Список» на телефоне) -->
    <LinearLayout android:id="@+id/side" android:layout_width="380dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="#E60B1220" android:orientation="vertical"
        android:paddingTop="12dp" android:visibility="gone">
        <TextView android:id="@+id/sideTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp"
            android:singleLine="true" android:ellipsize="end" android:textColor="@color/muted" android:textSize="14sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/sideList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Сведения о канале снизу -->
    <LinearLayout android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="20dp" android:background="@drawable/panel_bg"
        android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/infoNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="12dp" android:textColor="@color/accent2" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/infoName" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/infoClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textSize="16sp" />
        </LinearLayout>
        <TextView android:id="@+id/infoGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:id="@+id/infoNow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/text" android:textSize="16sp" android:visibility="gone" />
        <ProgressBar android:id="@+id/infoProg" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
            android:max="1000" android:progressTint="@color/accent" android:visibility="gone" />
        <TextView android:id="@+id/infoNext" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/infoBtns" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/bList" android:layout_width="wrap_content" android:layout_height="40dp"
                android:background="@drawable/btn_bg" android:focusable="true" android:clickable="true" android:gravity="center"
                android:paddingStart="18dp" android:paddingEnd="18dp" android:text="☰  Каналы" android:textColor="@color/text" />
            <TextView android:id="@+id/bFav" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:text="☆  В избранное" android:textColor="@color/text" />
            <TextView android:id="@+id/bFit" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:text="⛶  Формат" android:textColor="@color/text" />
            <TextView android:id="@+id/bAudio" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginStart="10dp" android:background="@drawable/btn_bg" android:focusable="true"
                android:clickable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
                android:text="♪  Звук" android:textColor="@color/text" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
