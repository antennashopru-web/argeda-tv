<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape><solid android:color="@color/text" /><corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="@color/focusRing" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="@color/focusRing" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/text" /><corners android:radius="22dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/panel2" /><corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/border" /></shape>
    </item>
</selector>
