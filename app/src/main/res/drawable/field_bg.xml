<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/accentLight" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/panel2" /><corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" /></shape>
    </item>
</selector>
