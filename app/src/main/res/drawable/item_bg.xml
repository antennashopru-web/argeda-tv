<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="@color/focusRing" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/selected" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
