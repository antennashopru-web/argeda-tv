<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="0" android:startColor="#6D28D9" android:endColor="#A855F7" /><corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/focusRing" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="0" android:startColor="#5B21B6" android:endColor="#9333EA" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="0" android:startColor="#6D28D9" android:endColor="#A855F7" /><corners android:radius="16dp" /></shape>
    </item>
</selector>
